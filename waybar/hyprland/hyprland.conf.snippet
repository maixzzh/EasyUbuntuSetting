# ============================================================================
#  Hyprland 侧配置片段 (标准 hyprland.conf 写法)
#  用法: 把下面需要的行复制到 ~/.config/hypr/hyprland.conf
# ----------------------------------------------------------------------------
#  这里的内容不在 install.sh 的职责范围内 —— 脚本只装 waybar, 不碰你的
#  合成器配置。请按需手动添加。
# ============================================================================


# ---------------------------------------------------------------------------
#  [必需] 自启动 waybar
# ---------------------------------------------------------------------------
# exec-once 表示「Hyprland 启动时执行一次」, 不会随配置重载重复执行。
exec-once = waybar


# ---------------------------------------------------------------------------
#  [强烈建议] polkit 认证代理
# ---------------------------------------------------------------------------
# 为什么需要:
#   图形化的网络设置 (nm-connection-editor) 在保存连接、连接新 WiFi 时
#   需要 polkit 授权。polkit 代理就是负责弹出那个「请输入密码」对话框的
#   程序。GNOME / KDE 桌面自带代理, 但 Hyprland 不会自动拉起任何代理 ——
#   这是 Hyprland 新用户最容易踩的坑。
#
# 缺了它会怎样:
#   点击「保存」没有任何反应, 也不报错。不是崩溃, 是请求根本没人处理。
#   这类「静默失败」极难自查, 所以务必装上。
#
# Ubuntu 上三选一 (任选其一安装):
#   sudo apt install lxpolkit            # 最轻量, 推荐
#   sudo apt install mate-polkit         # MATE 的, 也很轻
#   sudo apt install policykit-1-gnome   # 较老, 部分版本已移除
#
# 装完取消下面这行的注释:
# exec-once = lxpolkit


# ---------------------------------------------------------------------------
#  [可选] 让面板以居中浮窗打开
# ---------------------------------------------------------------------------
# 仅当你把 waybar 的点击目标改成了 KDE 面板 (plasmawindowed) 时才需要。
# 本项目默认使用 Ubuntu 原生工具 (pavucontrol / nm-connection-editor /
# gnome-system-monitor), 它们本来就是普通窗口, 不需要任何窗口规则。
#
# ⚠ Hyprland 的 windowrule 语法在不同版本间有变动 (老版本写 `float`,
#   新版本写 `float on`)。下面按较新的写法给出, 若报错请查阅
#   https://wiki.hypr.land/Configuring/Window-Rules/ 对照你的版本改写。
#
# windowrule = float on,   class:^(org\.kde\.plasmawindowed)$
# windowrule = center on,  class:^(org\.kde\.plasmawindowed)$
# windowrule = size 860 680, class:^(org\.kde\.plasmawindowed)$
